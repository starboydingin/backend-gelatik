# ==============================================================
# REALTIME & INTEGRATION SERVICE (.env.example)
# Panduan Konfigurasi Production untuk TIM TIK Diskominfotik
# ==============================================================

# Port server Node.js (default 4000)
PORT=4000

# Mode lingkungan: WAJIB diganti ke 'production' saat dipasang di server resmi
NODE_ENV=production

# Base URL Backend Laravel (dipakai untuk validasi token & callback webhook WA)
LARAVEL_BASE_URL=http://127.0.0.1:8000

# Shared Secret Key internal antar Laravel dan Node.js
# WAJIB SAMA PERSIS dengan INTERNAL_SERVICE_API_KEY di .env milik Laravel
INTERNAL_SERVICE_API_KEY=ganti_dengan_token_rahasia_minimal_64_karakter

# Nama instance WhatsApp Gateway yang terdaftar di engine gateway
WHATSAPP_GATEWAY_INSTANCE=layanantik-gateway

# Daftar Origin yang diizinkan terhubung via WebSockets / CORS (dipisahkan koma)
# Pada server production, isi dengan URL frontend/backend resmi (misal: https://layanantik.lampungprov.go.id)
SOCKET_CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Path lokasi penyimpanan session autentikasi WhatsApp (Baileys multi-file auth state)
WHATSAPP_SESSION_PATH=./auth_session

# Level logging aplikasi (info, warn, error, debug)
LOG_LEVEL=info
