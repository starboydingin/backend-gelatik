APP_NAME="Layanan TIK - Backend Terpadu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================
# DATABASE — sudah diimpor manual oleh pengguna ke phpMyAdmin
# Nama database aktual: db_layanantik (BUKAN nama internal dump aslinya)
# ==============================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_layanantik
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local

# QUEUE — wajib "database" karena tabel jobs/failed_jobs sudah ada di dump SQL
QUEUE_CONNECTION=database

SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@layanantik.lampungprov.go.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================
# LARAVEL PASSPORT (OAuth2 — autentikasi API existing)
# Isi setelah menjalankan: php artisan passport:install
# ==============================
PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

# ==============================
# F-RT & F-WA — Node.js Realtime & Integration Service
# Wajib SAMA PERSIS dengan INTERNAL_SERVICE_API_KEY di .env milik realtime-service
# ==============================
NODE_SERVICE_URL=http://127.0.0.1:4000
INTERNAL_SERVICE_API_KEY=ganti_dengan_string_acak_panjang_dan_rahasia

# ==============================
# F-WA — WhatsApp Gateway (dikonsumsi oleh Node.js, bukan Laravel langsung)
# Nama instance dipakai saat memanggil endpoint gateway
# ==============================
WHATSAPP_GATEWAY_INSTANCE=layanantik-gateway

# ==============================
# F-BOT — LLM Provider (Google Gemini utama, Groq fallback)
# ==============================
GEMINI_API_KEY=isi_dengan_api_key_gemini_anda
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=isi_dengan_api_key_groq_anda
GROQ_MODEL=llama-3.3-70b-versatile

# ==============================
# F-LAPORAN — tidak butuh env tambahan
# (memakai maatwebsite/excel & barryvdh/laravel-snappy yang sudah ada di composer.json)
# ==============================

# ==============================
# SIMKI API (integrasi dashboard existing)
# Isi sesuai kredensial yang sudah dipakai backend lama
# ==============================
SIMKI_API_BASE_URL=
SIMKI_API_KEY=
